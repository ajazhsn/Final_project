name: plant-disease-detection

python_env: python_env.yaml

entry_points:
  train_svm:
    parameters:
      C: {type: float, default: 1.0}
      kernel: {type: string, default: "rbf"}
      max_per_class: {type: int, default: 80}
    command: "python3 src/train.py --model svm"

  train_mlp:
    parameters:
      learning_rate: {type: float, default: 0.001}
      epochs: {type: int, default: 20}
      max_per_class: {type: int, default: 80}
    command: "python3 src/train.py --model mlp"

  train_cnn:
    parameters:
      learning_rate: {type: float, default: 0.001}
      epochs: {type: int, default: 15}
      batch_size: {type: int, default: 32}
      max_per_class: {type: int, default: 80}
    command: "python3 src/train.py --model cnn"

  train_all:
    command: >
      python3 src/train.py --model svm &&
      python3 src/train.py --model mlp &&
      python3 src/train.py --model cnn

  finetune_cnn:
    parameters:
      learning_rate: {type: float, default: 0.0005}
      epochs: {type: int, default: 25}
      batch_size: {type: int, default: 32}
      max_per_class: {type: int, default: 150}
      registered_model: {type: string, default: "PlantDiseaseDetector"}
      model_alias: {type: string, default: "champion"}
    command: "python3 src/finetune.py --learning_rate {learning_rate} --epochs {epochs} --batch_size {batch_size} --max_per_class {max_per_class} --registered_model {registered_model} --model_alias {model_alias}"  